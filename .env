# ==============================
# DATABASE CONFIGURATION
# ==============================
# Pour PostgreSQL local
DATABASE_URL=postgresql://postgres:azerty@localhost:5432/ride_db

# ==============================
# SERVER CONFIGURATION
# ==============================
PORT=5000
NODE_ENV=development

# ==============================
# SESSION / SECURITY
# ==============================
SESSION_SECRET=super_secret_key_2026

# ==============================
# HTTPS CONFIGURATION (désactivé)
# ==============================
ENABLE_HTTPS=false

# ==============================
# CORS & SECURITY HEADERS
# ==============================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================
# OPTIONNEL
# ==============================
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=jwt_secret_change_this_in_production_2026
JWT_EXPIRES_IN=7d

# Upload limits
MAX_FILE_SIZE=20971520
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# ==============================
# SENTRY (optionnel)
# ==============================
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# ==============================
# LOGGING
# ==============================
LOG_LEVEL=debug

# ==============================
# EMAIL SMTP CONFIGURATION (SendGrid)
# ==============================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-api-key-here
SMTP_FROM=noreply@farady.com

# Alternative avec Gmail (moins recommandé)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre_email@gmail.com
# SMTP_PASS=votre_mot_de_passe_application
# SMTP_FROM=noreply@farady.com

# ==============================
# SMS CONFIGURATION (Twilio - optionnel)
# ==============================
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890