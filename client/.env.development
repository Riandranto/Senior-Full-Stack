# ==============================
# DEVELOPMENT ENVIRONMENT
# ==============================
NODE_ENV=development

# ==============================
# API CONFIGURATION
# ==============================
# HTTP en développement - IMPORTANT: utiliser localhost:5000
VITE_API_URL=http://localhost:5000

# ==============================
# DATABASE (uniquement pour le build)
# ==============================
DATABASE_URL=postgresql://postgres:azerty@localhost:5432/ride_db

# ==============================
# SESSION SECURITY
# ==============================
SESSION_SECRET=super_secret_key_2026

# ==============================
# SERVER PORT
# ==============================
PORT=5000

# ==============================
# DEVELOPMENT TOOLS
# ==============================
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_LOGGING=true
VITE_ENABLE_MOCK_API=false

# ==============================
# SECURITY (développement seulement)
# ==============================
VITE_DISABLE_HTTPS_WARNING=true
VITE_BYPASS_CSP=true
VITE_DISABLE_CSP=true
VITE_DISABLE_SW=true