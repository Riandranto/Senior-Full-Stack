# ==============================
# PRODUCTION ENVIRONMENT
# ==============================
NODE_ENV=production

# ==============================
# API CONFIGURATION
# ==============================
# URL pour Render.com
VITE_API_URL=https://senior-full-stack.onrender.com

# ==============================
# DATABASE (pour Render)
# ==============================
DATABASE_URL=postgresql://postgres.tqqrawqpqehetikoewsg:riandranto1234@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require

# ==============================
# SESSION SECURITY
# ==============================
SESSION_SECRET=un-secret-tres-long-et-complexe-pour-la-production-2026-avec-au-moins-32-caracteres

# ==============================
# SERVER PORT
# ==============================
