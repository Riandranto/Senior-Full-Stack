# ==============================
# PRODUCTION ENVIRONMENT
# ==============================
NODE_ENV=production

# ==============================
# API CONFIGURATION
# ==============================
# URL HTTPS en production
VITE_API_URL=https://senior-full-stack.onrender.com
# Alternative: VITE_API_URL=https://votredomaine.com

# ==============================
# DATABASE (uniquement pour le build)
# ==============================
DATABASE_URL=postgresql://postgres:riandranto12@db.tqqrawqpqehetikoewsg.supabase.co:5432/postgres

# ==============================
# SESSION SECURITY
# ==============================
SESSION_SECRET=un-secret-tres-long-et-complexe-pour-la-production-2026-avec-au-moins-32-caracteres

# ==============================
# SERVER PORT
# ==============================
PORT=5000

# ==============================
# SECURITY HEADERS
# ==============================
# Content Security Policy (CSP) pour le frontend
VITE_CSP_DEFAULT_SRC="'self'"
VITE_CSP_SCRIPT_SRC="'self' 'unsafe-inline'"
VITE_CSP_STYLE_SRC="'self' 'unsafe-inline'"

# ==============================
# FEATURE FLAGS
# ==============================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true